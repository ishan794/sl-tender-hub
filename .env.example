# ===========================================================================
#  LOGIN POINTERS for your tender website
#  HOW TO USE:
#     1) copy this file:      cp .env.example .env
#     2) fill in the 4 lines marked 👉
#     3) test:                python check_login.py
#     4) collect the data:    python run_scraper.py
#
#  .env is git-ignored -> your password never goes to GitHub.
# ===========================================================================

# 👉 POINTER 1 - the LINK of your tender website
TENDER_SITE_URL=https://your-tender-site.lk

# 👉 POINTER 2 - the LOGIN E-MAIL (or username)
TENDER_LOGIN_EMAIL=you@example.com

# 👉 POINTER 3 - the PASSWORD
TENDER_LOGIN_PASSWORD=your-password-here

# 👉 POINTER 4 - the login page link (leave empty to try /login automatically)
TENDER_LOGIN_URL=

# ---------------------------------------------------------------------------
# OPTIONAL - only needed if the automatic detection does not fit your site.
# Uncomment the line you need and fill it in.
# ---------------------------------------------------------------------------

# Name shown in the logs / database
#TENDER_SITE_NAME=My Tender Site

# login style: form (normal web login) | json (API login) | token | basic
#TENDER_AUTH_METHOD=form

# API login: TENDER_AUTH_METHOD=json + the login endpoint
#TENDER_LOGIN_API_URL=https://your-tender-site.lk/api/login
#TENDER_TOKEN_JSON_PATH=data.token
#TENDER_TOKEN_HEADER=Authorization
#TENDER_TOKEN_PREFIX=Bearer%20

# Already have an API key? use TENDER_AUTH_METHOD=token and the key:
#TENDER_AUTH_TOKEN=

# The <input name="..."> of the login form (only if auto-detection fails)
#TENDER_EMAIL_FIELD=email
#TENDER_PASSWORD_FIELD=password

# A word that is only visible AFTER login (makes the login check 100% sure)
#TENDER_SUCCESS_MARKER=logout

# The page that lists the tenders. Use {page} for pagination:
#TENDER_LIST_URL=https://your-tender-site.lk/tenders?page={page}
#TENDER_PAGE_PARAM=page
#TENDER_START_PAGE=1
#TENDER_MAX_PAGES=50

# CSS selectors (press F12 in the browser, right-click a tender row -> Copy selector)
#TENDER_ROW_SELECTOR=table.tenders tbody tr
#TENDER_TITLE_SELECTOR=.title a
#TENDER_LINK_SELECTOR=a
#TENDER_CLOSING_SELECTOR=.closing-date
#TENDER_PUBLISHED_SELECTOR=.published-date

# If the site has a JSON list endpoint instead of HTML:
#TENDER_JSON_LIST_URL=https://your-tender-site.lk/api/tenders?page={page}
#TENDER_JSON_LIST_PATH=data
